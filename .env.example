# ── All In Capital screener — every variable, one line each. Copy to .env.local (git-ignored). Never commit real values.

APP_ENV=dev                   # dev | test | prod — picks the Neon branch; only prod uses DATABASE_URL

# Database (Neon Postgres + pgvector)
DATABASE_URL=                 # Neon prod (main branch) — used only when APP_ENV=prod
DATABASE_URL_DEV=             # Neon dev/test branch — used by dev, tests and migrations by default. Local/no-network: pglite://./.pglite

# Models (Gemini). IDs are NEVER hard-coded; prices live in the model_prices table.
GEMINI_API_KEY=               # Google AI Studio key (stored as provider credential in Portkey too)
GEMINI_MODEL_FAST=            # fast model for extraction/classification (set from the current Gemini model list)
GEMINI_MODEL_SMART=           # stronger model for scoring/judging
GEMINI_EMBEDDING_MODEL=       # embedding model; output dimension requested = 768

# Gateway (Portkey) — every model call goes through it
PORTKEY_API_KEY=              # Portkey workspace API key
PORTKEY_VIRTUAL_KEY_GEMINI=   # Portkey virtual key / provider slug holding the Gemini key
PORTKEY_CONFIG_ID=            # Portkey config with retry/fallback/budget limits

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=          # Langfuse project public key
LANGFUSE_SECRET_KEY=          # Langfuse project secret key
LANGFUSE_HOST=https://cloud.langfuse.com  # Langfuse region host

# Queue (Inngest)
INNGEST_EVENT_KEY=            # send events
INNGEST_SIGNING_KEY=          # verify Inngest → /api/inngest calls

# File storage
BLOB_READ_WRITE_TOKEN=        # Vercel Blob token for decks/forms

# Auth + Google (Gmail, Calendar)
AUTH_SECRET=                  # Auth.js secret (openssl rand -base64 32)
GOOGLE_CLIENT_ID=             # Google OAuth client id
GOOGLE_CLIENT_SECRET=         # Google OAuth client secret
ALLOWED_EMAILS=               # comma-separated staff allow-list
RIYA_EMAIL=                   # associate; owns the booking calendar
KUSHAL_EMAIL=                 # partner
ADITYA_EMAIL=                 # partner; joins deeptech calls only

# Safety
TEST_MODE=true                # true = all outbound email → TEST_INBOX, calendar writes → test calendar
TEST_INBOX=                   # where outbound email goes in TEST_MODE
ALERT_EMAIL=                  # budget / stuck-job alerts
SLACK_WEBHOOK_URL=            # optional: alerts to Slack too
PII_ENCRYPTION_KEY=           # 32-byte base64 (openssl rand -base64 32) for founders_pii AES-GCM

# Rate limiting (optional — falls back to a Postgres limiter)
UPSTASH_REDIS_REST_URL=       # optional
UPSTASH_REDIS_REST_TOKEN=     # optional

# Research
TAVILY_API_KEY=               # optional second search provider

# Evals
JUDGE_PROVIDER=               # optional: anthropic|openai — a different-family judge via Portkey
JUDGE_API_KEY_VIRTUAL=        # optional: Portkey virtual key for the judge provider
EVAL_BASE_URL=                # deployed URL the eval harness calls (HTTP only)
EVAL_API_TOKEN=               # bearer token for internal API routes used by evals/scripts

# Limits
DAILY_LIMIT_INR=500           # daily LLM spend kill switch (first-boot default; editable in /settings)
SCORING_PER_MINUTE=5          # Inngest throttle for screening runs
WEB_CACHE_TTL_DAYS=7          # reuse fetched pages within this window
MAX_RESEARCH_ITER=4           # research loop iteration cap
MAX_RESEARCH_FETCHES=8        # research loop fetch cap
